<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Regression Test Suite" verbose="4">

    <listeners>
         <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
    </listeners>

    <test name="Go Rest API Test - Get User">
        <classes>
            <class name="com.qa.api.gorest.tests.GetUserTest" />
        </classes>
    </test>

    <test name="Go Rest API Test - Create User">
        <classes>
            <class name="com.qa.api.gorest.tests.CreateUserTest" />
        </classes>
    </test>

    <test name="Go Rest API Test - Update User">
        <classes>
            <class name="com.qa.api.gorest.tests.UpdateUserTest" />
        </classes>
    </test>

    <test name="Go Rest API Test - Delete User">
        <classes>
            <class name="com.qa.api.gorest.tests.DeleteUserTest" />
        </classes>
    </test>

    <test name="Product API Test - Get Product">
        <classes>
            <class name="com.qa.api.products.ProductApiTest" />
        </classes>
    </test>

    <test name="Product API Test - Get Product With Json Path">
        <classes>
            <class
                    name="com.qa.api.products.ProductApiTestWithJsonPath" />
        </classes>
    </test>

    <test name="Schema Test">
        <classes>
            <class name="com.qa.api.scematest.GetUserApiSchemaApiTest" />
        </classes>
    </test>


